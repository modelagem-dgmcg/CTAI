# Copie este arquivo para ".env" e ajuste só o que precisar. Sem ".env", o sistema usa os padrões.
PORT=3000
# Pasta onde ficam o banco e os PDFs gerados
CTAI_DATA_DIR=data
# Senha temporária dos usuários de demonstração (cada um é obrigado a trocar no primeiro acesso)
CTAI_SENHA_TEMPORARIA=Trocar@123
# Painel do console para criadores e colegas: "nao" (padrão) = começam na Caixa de entrada; "sim" devolve o item Painel e a tela inicial antiga.
CTAI_PAINEL_ANALISTA=nao
# Use "sim" quando o sistema estiver atrás de HTTPS (hospedagem)
CTAI_COOKIE_SEGURO=nao
# Duração da sessão, em horas
CTAI_SESSAO_HORAS=12

# ---- Analista: provedores de IA (todos desligados sem chave) ----
# Ordem de tentativa, separada por vírgula. "local-regras" funciona sem internet e sem chave.
ANALISTA_ORDEM=local-regras,gemini,groq,kimi,deepseek,openrouter,ollama
GEMINI_API_KEY=
GROQ_API_KEY=
KIMI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_URL=http://localhost:11434
# Somente a cópia de trabalho, com dados sensíveis mascarados, pode sair para provedores em nuvem
ANALISTA_ENVIAR_NUVEM=nao

# ---- Exposição (túnel/internet) ----
# "restrita" (padrão): quem chega por túnel ou host público só alcança o Portal da Unidade; console da CTAI, Gestão CTAI, análise e administração respondem 404.
# "aberta": sem bloqueio (só para desenvolvimento local).
CTAI_EXPOSICAO=restrita
# Hosts públicos (separados por vírgula), ex.: portal.exemplo.gov.br. Chegar por eles = origem externa.
CTAI_HOSTS_PUBLICOS=
# Hosts de proxy interno confiáveis (X-Forwarded-Host que NÃO deve contar como externo).
CTAI_HOSTS_INTERNOS=
# Lista de IPs internos (IPs ou CIDR, separados por vírgula). Definida = só esses IPs veem o console da CTAI; os demais, só o Portal da Unidade.
# Use em hospedagem na nuvem (Render): docs/EXPOSICAO.md e docs/GUIA-RENDER.md. Vazia = comportamento por host/túnel.
CTAI_IPS_INTERNOS=
# Quantos valores o proxy da plataforma acrescenta ao X-Forwarded-For (Render: 2). 0 = sem proxy (IP da conexão).
CTAI_PROXY_SALTOS=1
# Cabeçalho de IP definido pela plataforma (opcional; ex.: true-client-ip). Só se a plataforma garantir.
CTAI_IP_CABECALHO=
# IPs/CIDR dos proxies de quem se aceitam cabeçalhos (opcional)
CTAI_PROXIES_CONFIAVEIS=
# Guardar o IP inteiro nos registros de acesso (padrão: mascarado, último trecho oculto)
CTAI_IP_COMPLETO=nao

# ---- Gestão CTAI: segredo que cifra as chaves de IA cadastradas na tela (mínimo de 16 caracteres; NUNCA vai para o repositório) ----
CTAI_SEGREDO=

# ---- Rack da API do MV (veja docs/INTEGRACAO-MV.md) ----
MV_API_BASE_URL=
MV_API_TOKEN=
MV_API_USUARIO=
MV_API_SENHA=

# Recuperar acesso: logins cuja senha volta a CTAI_SENHA_TEMPORARIA ao reiniciar. Use uma vez e apague depois de entrar.
# CTAI_REDEFINIR_SENHA_DE=admin

# Teste: nao pedir troca da senha temporaria no primeiro acesso (a gestao redefine quando precisar).
# CTAI_TROCA_SENHA_OBRIGATORIA=nao

# ---- Ponte com o Analista da diretoria: contatos e mensagens (veja docs/INTEGRACAO-ANALISTA.md) ----
# URL da API do Analista (não é segredo; é a mesma do site do Analista).
ANALISTA_API_URL=https://script.google.com/macros/s/AKfycbzzcJEAQPUCwY5YC2o1O5bj500pRE2mOFfZrLCy-e2kFzIgoDkebamJBgQK_yV2Ez0b/exec
# Chave de serviço da CTAI: gerada no menu da planilha do Analista ("8. Gerar chave de serviço da CTAI"). NUNCA vai para o repositório.
ANALISTA_SERVICO_CHAVE=

# ---- GAOCG (leitura de unidades, SOF, empenhos e recibos). Só a CTAI usa. Preencher só no painel da hospedagem. ----
# GAOCG_API_URL=      (endereço do web app do GAOCG, termina em /exec)
# GAOCG_API_CHAVE=    (chave de leitura gerada no GAOCG pelo Administrador do Aplicativo)

# Base da equipe: no primeiro start de um banco NOVO cria só admin, nathalia (superintendente) e as 4 analistas, sem usuários de demonstração.
# A carteira de unidades entra depois, em Gestão CTAI > Importar. Para recomeçar, aponte CTAI_DB para um arquivo novo.
# CTAI_SEMENTE=equipe
